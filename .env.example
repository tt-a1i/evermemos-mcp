# EverMemOS Cloud defaults are built into src/evermemos_mcp/config.py:
#   EVERMEMOS_BASE_URL=https://api.evermind.ai
#   EVERMEMOS_API_VERSION=v0
# For Cloud usage, you usually only need to set API key.
EVERMEMOS_API_KEY=

# Optional overrides
# EVERMEMOS_BASE_URL=https://api.evermind.ai
# EVERMEMOS_API_VERSION=v0
# EVERMEMOS_SPACE_ID=

# Local self-hosted example (no key required by this project on v1)
# EVERMEMOS_BASE_URL=http://localhost:8001
# EVERMEMOS_API_VERSION=v1
